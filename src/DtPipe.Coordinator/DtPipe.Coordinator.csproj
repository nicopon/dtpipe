<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- A library hosted inside an ASP.NET Core app (the SignalR hub and its filters), never an app:
         the host owns Program, the identity provider and the listening address. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DtPipe.Coordinator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The node channel's messages and the one composition of a fragment's job, shared with every node host. -->
    <ProjectReference Include="..\DtPipe.Coordinator.Contracts\DtPipe.Coordinator.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DefaultFlowControlService, the plan's edge check, is in the TransportR.Hub package's assembly,
         namespace TransportR.Hub. -->
    <PackageReference Include="TransportR" Version="0.14.0" />
    <PackageReference Include="TransportR.Hub" Version="0.14.0" />
  </ItemGroup>

</Project>
