<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DtPipe.Coordinator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="TransportR">
      <HintPath>..\..\lib\TransportR\TransportR.dll</HintPath>
    </Reference>
    <Reference Include="TransportR.Hub.SignalR">
      <HintPath>..\..\lib\TransportR\TransportR.Hub.SignalR.dll</HintPath>
    </Reference>
    <Reference Include="TransportR.FlowControl">
      <HintPath>..\..\lib\TransportR\TransportR.FlowControl.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- TransportR.Hub.SignalR's own transitive dependencies; a private Reference does not pull
         them in the way a PackageReference would, so they are declared here at TransportR's own
         pinned version (see TransportR.Hub.SignalR.csproj). -->
    <PackageReference Include="OpenTelemetry" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
  </ItemGroup>

</Project>
