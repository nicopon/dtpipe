<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- A library hosted inside an ASP.NET Core app (the SignalR hub and its filters), never an app:
         the host owns Program, the identity provider and the listening address. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DtPipe.Coordinator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- TransportR.FlowControl (DefaultFlowControlService, the plan's edge check) ships inside
         this package's assembly now; there is no separate TransportR.FlowControl package. -->
    <PackageReference Include="TransportR" Version="0.3.1" />
    <PackageReference Include="TransportR.Hub.SignalR" Version="0.3.1" />
  </ItemGroup>

</Project>
