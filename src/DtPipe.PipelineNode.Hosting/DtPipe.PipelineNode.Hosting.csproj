<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The only package of the distributed family. The family stays outside DtPipe.sln, so the solution's pack never reaches it:
         tests/scripts/validate_node_host_package.sh packs it, and release.yml runs that script in a step of its own. -->
    <IsPackable>true</IsPackable>
    <PackageId>DtPipe.PipelineNode.Hosting</PackageId>
    <Description>AddDtPipeNode: makes any .NET host a dtpipe pipeline node, and offers its own data as a source brick (AddArrowSource).</Description>
    <PackageTags>dtpipe;etl;arrow;pipeline</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- The assemblies of the three projects below ship inside this package, in lib/. -->
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);BundleProjectOutputs</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DtPipe.PipelineNode.Hosting.Tests" />
    <InternalsVisibleTo Include="DtPipe.PipelineNode.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- A library any .NET host adds a node to (AddDtPipeNode), never an application. The SignalR
         client of the node channel is this project's own dependency: TransportR's client does not carry it.
         The three projects are not packages: PrivateAssets keeps them out of the nuspec, BundleProjectOutputs puts their
         assemblies in lib/, and the packages they use are declared below, since a private reference does not carry them. -->
    <ProjectReference Include="..\DtPipe.PipelineNode\DtPipe.PipelineNode.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\DtPipe.Coordinator.Contracts\DtPipe.Coordinator.Contracts.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\DtPipe.Jobs\DtPipe.Jobs.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Apache.Arrow" Version="23.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    <PackageReference Include="TransportR" Version="0.11.2" />
    <PackageReference Include="TransportR.Client" Version="0.11.2" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same file twice: build/ for a project that references the package, buildTransitive/ for one that reaches it through
         a class library. -->
    <None Include="build\DtPipe.PipelineNode.Hosting.targets" Pack="true" PackagePath="build;buildTransitive" />
  </ItemGroup>

  <Target Name="BundleProjectOutputs" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_BundledOutput Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference'" />
      <BuildOutputInPackage Include="@(_BundledOutput)" Condition="'%(_BundledOutput.Extension)' == '.dll'" />
    </ItemGroup>
  </Target>

</Project>
