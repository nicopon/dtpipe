<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The coordinator's server: a host of DtPipe.Coordinator (AddCoordinatorHub, IRunOrchestrator,
         ReplicaRegistry, IPlanRegistry), used exactly as that library's own tests use it. -->
    <ProjectReference Include="..\DtPipe.Coordinator\DtPipe.Coordinator.csproj" />
    <ProjectReference Include="..\DtPipe.Coordinator.Contracts\DtPipe.Coordinator.Contracts.csproj" />
    <!-- The designer's cards: the same model dtpipe studio composes with, never a copy. -->
    <ProjectReference Include="..\DtPipe.Jobs\DtPipe.Jobs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- An external OpenID Connect provider issues every token: services present bearer tokens,
         people sign in through the provider into a session cookie. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" />
    <!-- The run journal's store. TransportR's own Redis store is a separate package this server does not use. -->
    <PackageReference Include="StackExchange.Redis" Version="3.3.1" />
  </ItemGroup>

</Project>
