<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- A library a host adds the server to (AddCoordinatorServer, MapCoordinatorServerAsync); its wwwroot reaches every host
         that references it, at the root of the site. -->
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The coordinator's server: a host of DtPipe.Coordinator (AddCoordinatorHub, IRunOrchestrator,
         ReplicaRegistry, IPlanRegistry), used exactly as that library's own tests use it. -->
    <ProjectReference Include="..\DtPipe.Coordinator\DtPipe.Coordinator.csproj" />
    <ProjectReference Include="..\DtPipe.Coordinator.Contracts\DtPipe.Coordinator.Contracts.csproj" />
    <!-- The designer's cards: the same model dtpipe studio composes with, never a copy. -->
    <ProjectReference Include="..\DtPipe.Jobs\DtPipe.Jobs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DtPipe.Coordinator.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- An external OpenID Connect provider issues the tokens, or the coordinator's key issuer for an identity verified by a key:
         services present bearer tokens, people sign in through the provider into a session cookie. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" />
    <!-- The drivers of the stores the state can be kept in (Coordinator:Store), the same versions as the adapters'. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <!-- SqlClient brings this transitively; pinned to the adapters' version, above the ones with a known advisory (NuGet audit is an error here). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
