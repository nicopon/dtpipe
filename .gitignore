*.db
*.duckdb
*.sqlite
*.sqlite3

# Test Data
tests/output/*
tests/artifacts/
tests/DtPipe.Tests/Data/Target/*
!tests/DtPipe.Tests/Data/Target/.gitkeep
tests/scripts/artifacts/*
