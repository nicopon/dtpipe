tests/scripts/sandbox/

# Debug and Temp
*.log
*.arrow
*.arrows
*.output
test_*.yaml

# Native bridges (built by CI, not tracked in source)
src/DtPipe.Processors/DataFusion/*.dylib
src/DtPipe.Processors/DataFusion/*.so
src/DtPipe.Processors/DataFusion/*.dll
src/DtPipe.Processors/DataFusion/*.dSYM/
src/DtPipe.Processors/runtimes/*
dist/release/.env

# Experiments
experiments/*
.claude/*
!.claude/skills/
tests/DtPipe.Tests/TestResults/*
nuget-packages/*

