# User specific
.dotnet_home/
.nuget_packages/
.nuget_cache/
.nuget_plugins/
.nuget_scratch/
# No trailing slash: `.notes/` matches a directory only, and `.notes` is a symlink
# into the notes repository. With the slash git reported it as an untracked file.
.notes
.notes_*.zip
.scripts/
.tmp/

testScripts/
exports/

# Build results
[Bb]in/
[Oo]bj/
dist/

# Rust
target/

# IDEs
.idea/
.vscode/
*.swp
*.suo
*.user
*.sln.docstates

# OS
.DS_Store
Thumbs.db

