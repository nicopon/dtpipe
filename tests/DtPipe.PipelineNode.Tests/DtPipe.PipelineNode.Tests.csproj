<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Suppress xUnit1051: style warning about TestContext.Current.CancellationToken, same as DtPipe.Tests. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DtPipe.PipelineNode\DtPipe.PipelineNode.csproj" />
    <ProjectReference Include="..\..\src\DtPipe.Coordinator\DtPipe.Coordinator.csproj" />
    <!-- CoordinatorTestHost: the same in-process Kestrel-hosted coordinator DtPipe.Coordinator.Tests
         uses, reused here rather than duplicated. -->
    <ProjectReference Include="..\DtPipe.Coordinator.Tests\DtPipe.Coordinator.Tests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every TransportR package this project, DtPipe.Coordinator and DtPipe.Coordinator.Tests
         touch flows transitively through the ProjectReferences above; nothing to declare here. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
