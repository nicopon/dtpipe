<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Suppress xUnit1051: style warning about TestContext.Current.CancellationToken, same as DtPipe.Tests. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DtPipe.Coordinator\DtPipe.Coordinator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- TransportR and TransportR.Hub.SignalR flow transitively through the ProjectReference
         above; only what this test project uses directly (standing in for pipeline nodes) needs
         its own PackageReference. -->
    <PackageReference Include="TransportR.Client.SignalR" Version="0.3.1" />
    <PackageReference Include="TransportR.Serialization.MessagePack" Version="0.3.1" />

    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
