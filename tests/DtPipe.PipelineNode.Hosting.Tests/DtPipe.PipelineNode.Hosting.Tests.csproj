<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Suppress xUnit1051: style warning about TestContext.Current.CancellationToken, same as DtPipe.Tests. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\TestBricks.cs" Link="Shared\TestBricks.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DtPipe.PipelineNode.Hosting\DtPipe.PipelineNode.Hosting.csproj" />
    <!-- A real coordinator on a port, whose key issuer a node's token client reaches as it reaches any provider. -->
    <ProjectReference Include="..\..\src\DtPipe.Coordinator.Server\DtPipe.Coordinator.Server.csproj" />
    <ProjectReference Include="..\..\src\DtPipe.Coordinator.Host\DtPipe.Coordinator.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The coordinator's framework, as the server has it: it provides the hosting and configuration packages, and the ones its
         dependencies pin older versions of. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
