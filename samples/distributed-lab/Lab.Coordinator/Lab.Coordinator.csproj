<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>DtPipe.Lab.Coordinator</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Consumed as a library, never modified: AddCoordinatorHub, IRunOrchestrator, INodeRegistry
         and IPlanRegistry are used exactly as DtPipe.Coordinator's own tests use them. -->
    <ProjectReference Include="..\..\..\src\DtPipe.Coordinator\DtPipe.Coordinator.csproj" />
    <ProjectReference Include="..\..\..\src\DtPipe.Coordinator.Contracts\DtPipe.Coordinator.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tokens are issued by an external OpenID Connect provider (the lab's Lab.Idp) and validated here. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
  </ItemGroup>

</Project>
