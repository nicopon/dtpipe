<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>DtPipe.Lab.Coordinator</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Consumed as a library, never modified: AddCoordinatorHub, IRunOrchestrator, INodeRegistry
         and IPlanRegistry are used exactly as DtPipe.Coordinator's own tests use them. -->
    <ProjectReference Include="..\..\..\src\DtPipe.Coordinator\DtPipe.Coordinator.csproj" />
    <ProjectReference Include="..\Lab.Contracts\Lab.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The embedded identity provider, after TransportR's SimpleIdp. -->
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.7.1" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.7.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
  </ItemGroup>

</Project>
